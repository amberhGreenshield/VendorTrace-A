# Copy to api/.env for LOCAL development only. api/.env is git-ignored —
# never commit it. In Azure, these are App Service "Environment variables",
# with secrets pulled from Key Vault (see SECURITY.md). Placeholders only.

# Local Postgres (Docker) — never put the Azure production connection string here.
DATABASE_URL=postgresql://vendortrace:localdevpassword@localhost:5432/vendortrace

# Microsoft Graph (SharePoint). Leave blank locally to use "SharePoint pending" mode.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_ROOT_FOLDER=Risk Assessments/VendorTrace

# Optional
PORT=4000
APP_URL=http://localhost:5173
# JOB_SECRET=            # enables POST /api/jobs/assessment-reminders
# REMINDERS_ENABLED=false
# REMINDER_FIRST_AFTER_DAYS=7
# REMINDER_REPEAT_EVERY_DAYS=7
# MIGRATE_ON_START=false
